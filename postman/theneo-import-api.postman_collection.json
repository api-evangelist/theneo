{
  "info": {
    "_postman_id": "93517054-83e8-435e-ae96-e2ea645b625b",
    "name": "Theneo Import API",
    "description": "The Theneo API provides programmatic access to manage API documentation projects, workspaces, user access, and API specification imports on the Theneo platform. Theneo is an AI-powered API documentation tool that generates interactive docs from OpenAPI, Swagger, Postman, and GraphQL specifications.\n\nContact Support:\n Name: Theneo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:10:53.000Z",
    "updatedAt": "2026-07-28T03:10:53.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-93517054-83e8-435e-ae96-e2ea645b625b"
  },
