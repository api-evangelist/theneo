                          "id": "f3e5a41a-de32-44a8-a726-b2c7cad4e923",
                          "key": "projectId",
                          "value": "<string>",
                          "description": "(Required) The unique identifier of the project."
                        }
                      ]
                    },
                    "description": "Imports an API specification file into an existing project. Supports OpenAPI/Swagger, Postman Collections, GraphQL, gRPC, SOAP/WSDL, and AsyncAPI formats. The import can be done via file upload, URL, or text."
